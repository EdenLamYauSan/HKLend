# ─────────────────────────────────────────────────────────────────────────────
# WARNING: THIS IS YOUR LOCAL DEV DATABASE — all values here are placeholders.
# Never commit real secrets. Copy to .env.local and fill in your own values.
# ─────────────────────────────────────────────────────────────────────────────

# DATABASE — local dev Postgres (NOT the production database)
# THIS IS YOUR LOCAL DEV DATABASE — do not use the production URL here.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hklend_dev

# Scraper uses a separate connection pool
SCRAPER_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hklend_dev

# Admin authentication (iron-session)
# SESSION_SECRET must be at least 32 random characters
SESSION_SECRET=replace-with-32-plus-random-chars-here
ADMIN_PASSWORD=replace-with-admin-password

# Borrower authentication (Auth.js v5 — email magic link, Story 8.1)
# ARCH-6: separate island from the admin auth above — two cookies, two libraries.
# AUTH_SECRET must be at least 32 random characters (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-32-plus-random-chars-here
# Resend API key — https://resend.com/api-keys
AUTH_RESEND_KEY=replace-with-resend-api-key
AUTH_EMAIL_FROM=login@replace-with-your-domain.com
# Optional — only needed when the deploy URL cannot be inferred (Vercel infers it automatically)
AUTH_URL=

# Cloudflare Turnstile — community submission protection
# Get test keys from: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Upstash Redis — rate limiting
KV_REST_API_URL=https://replace-with-your-upstash-url.upstash.io
KV_REST_API_TOKEN=replace-with-your-upstash-token

# ISR revalidation webhook secret (called by scraper after sync)
REVALIDATION_SECRET=replace-with-revalidation-secret

# PostHog — product analytics (clicks, session replays, funnels, heatmaps)
# Sign up at posthog.com, use EU region for HK/PDPO alignment.
# If unset, PostHog is disabled — safe to ship without a key.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
