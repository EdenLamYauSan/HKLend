// This is your Prisma schema file.
// Migration workflow: ALWAYS use --create-only and hand-edit. NEVER run bare prisma migrate dev or prisma db push.
// See prisma/migrations/README.md for the full workflow.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Lender ─────────────────────────────────────────────────────────────────

model Lender {
  id              String   @id @default(cuid())
  slug            String   @unique
  licenceNumber   String   @unique
  licenceStatus   String   // ACTIVE | SUSPENDED | REVOKED
  companyNameZh   String
  companyNameEn   String?
  addressZh       String?
  addressEn       String?
  districtZh      String?
  districtEn      String?
  licenceIssuedDate DateTime?
  licenceExpiryDate DateTime?
  phone           String?
  websiteUrl      String?

  // JSONB column — array of alternative name strings for trigram search.
  // aliases_text generated column and GIN index are defined in the raw migration SQL.
  searchAliases   Json     @default("[]")

  loanTypeTags    String[] @default([])

  // Valid values: employed | self-employed | freelancer | part-time | unemployed | no-hkid
  eligibilityTags String[] @default([])

  interestRateMin Decimal?
  interestRateMax Decimal?

  lastScrapedAt   DateTime?
  scrapeStatus    String?   // SUCCESS | PARTIAL | FAILED

  adminNote       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  activityEvents  ActivityEvent[]
  reviews         Review[]
  flags           Flag[]

  @@map("Lender")
}

// ─── ActivityEvent ───────────────────────────────────────────────────────────
// Chronological log of registry-detected changes on a lender.
// Written by the HKMA scraper when a diff is detected.
// Displayed in the Lender Activity Feed and Lender Pulse widget.

model ActivityEvent {
  id            String   @id @default(cuid())
  lenderId      String
  lender        Lender   @relation(fields: [lenderId], references: [id], onDelete: Cascade)

  // eventType closed set: STATUS_CHANGE | ADDRESS_CHANGE | NAME_CHANGE
  eventType     String

  // Human-readable descriptions (TC required, EN optional)
  descriptionZh String
  descriptionEn String?

  // Timestamp when the scraper detected this change
  detectedAt    DateTime

  createdAt     DateTime @default(now())

  // Index on (lenderId, detectedAt DESC) for profile feed queries
  @@index([lenderId, detectedAt(sort: Desc)])
  @@map("ActivityEvent")
}

// ─── ScrapeRun ───────────────────────────────────────────────────────────────
// Audit log of each scraper run. Admin dashboard queries the last 20 runs.
// ARCH-15: admin dashboard shows a warning when last successful run is >8 days old.

model ScrapeRun {
  id               String   @id @default(cuid())
  source           String   // 'hkma' | 'cr' | 'rate-scraper'
  startedAt        DateTime
  completedAt      DateTime?
  lendersInserted  Int      @default(0)
  lendersUpdated   Int      @default(0)
  errorCount       Int      @default(0)
  status           String   // SUCCESS | PARTIAL | FAILED
  notes            String?

  createdAt        DateTime @default(now())

  @@map("ScrapeRun")
}

// ─── Review ──────────────────────────────────────────────────────────────────
// Community review of a licensed money lender.
//
// Status lifecycle: PENDING → APPROVED (public) | REJECTED
// The overall display rating is computed dynamically as:
//   (ratingApprovalSpeed + ratingRateAccuracy + ratingStaffAttitude + ratingTransparency) / 4.0
// It is NEVER stored as a column to prevent it going stale relative to the dimensions.
//
// Minimum 3 approved reviews are required before aggregate ratings are shown
// publicly (FR-16 / Story 3.4).

model Review {
  id                    String   @id @default(cuid())
  lenderId              String
  lender                Lender   @relation(fields: [lenderId], references: [id], onDelete: Cascade)

  // ── 4-dimension ratings (1–5, all required) ─────────────────────────────
  ratingApprovalSpeed   Int
  ratingRateAccuracy    Int
  ratingStaffAttitude   Int
  ratingTransparency    Int

  // ── Content ─────────────────────────────────────────────────────────────
  body                  String   // 50–500 chars; stored as plain text, never rendered as HTML
  reviewerName          String?  // optional; max 20 chars; null displayed as "匿名"

  // ── Moderation ──────────────────────────────────────────────────────────
  status                String   @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason       String?

  // ── Community voting (Story 3.5) ─────────────────────────────────────────
  helpfulCount          Int      @default(0)
  notHelpfulCount       Int      @default(0)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Index for paginated approved-reviews-by-lender queries (newest first)
  @@index([lenderId, status, createdAt(sort: Desc)])
  @@map("Review")
}

// ─── Flag ─────────────────────────────────────────────────────────────────────
// Community red-flag submission for a licensed money lender.
//
// Status lifecycle: PENDING → APPROVED (public) | REJECTED
//
// Categories are stored as text constants (NOT Prisma enum) so adding a
// category requires only a code change, not a DB migration (FR-39, UX-DR8).
//
// Valid categories: HARASSMENT | ILLEGAL_TERMS | FAKE_IDENTITY | OVERCHARGING | OTHER
//
// Flag velocity (Story 4.4): rolling 30-day approved flag count displayed in
// Lender Pulse. Warning banner (Story 4.3): ≥5 approved flags in 90 days.
//
// Rate limit: 1 flag per (fingerprint+IP) per lender per 30 days (FR-43).

model Flag {
  id        String   @id @default(cuid())
  lenderId  String
  lender    Lender   @relation(fields: [lenderId], references: [id], onDelete: Cascade)

  // Category from the fixed constant set — stored as text (not enum)
  category  String   // HARASSMENT | ILLEGAL_TERMS | FAKE_IDENTITY | OVERCHARGING | OTHER

  // Optional free-text description (max 500 chars)
  details   String?

  // Moderation lifecycle
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Index for approved-flags-by-lender-by-date queries (velocity, warning banner)
  @@index([lenderId, status, createdAt(sort: Desc)])
  @@map("Flag")
}

// ─── ScamReport ───────────────────────────────────────────────────────────────
// User-submitted report of a suspected fraudulent lending entity.
//
// Status lifecycle: PENDING → VERIFIED (public) | REJECTED
//
// Verified reports appear on the public Scam Board (/zh/scam-board).
// Admin note is internal-only and never publicly displayed.
//
// Rate limit: 2 reports per (fingerprint+IP) per 24h.

model ScamReport {
  id                    String    @id @default(cuid())

  // Reported entity details
  companyName           String
  licenceNumberClaimed  String?   // claimed licence number (may be fake)
  incidentDate          DateTime? // approximate incident date
  lossAmountHkd         Int?      // estimated financial loss in HKD

  // Required evidence text (100–2000 chars)
  evidenceText          String

  // Moderation lifecycle
  status                String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  adminNote             String?   // internal only, never public

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Index for public scam board listing (newest verified first)
  @@index([status, createdAt(sort: Desc)])
  @@map("ScamReport")
}
