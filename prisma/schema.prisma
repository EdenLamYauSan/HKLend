// This is your Prisma schema file.
// Migration workflow: ALWAYS use --create-only and hand-edit. NEVER run bare prisma migrate dev or prisma db push.
// See prisma/migrations/README.md for the full workflow.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Lender ─────────────────────────────────────────────────────────────────

model Lender {
  id              String   @id @default(cuid())
  slug            String   @unique
  licenceNumber   String   @unique
  licenceStatus   String   // ACTIVE | SUSPENDED | REVOKED | PENDING | EXPIRED | DISMISSED | WITHDRAWN
  mlrNumber       Int?     // Court registry file number (MLR No.) — set for PDF-sourced records
  companyNameZh   String
  companyNameEn   String?
  addressZh       String?
  addressEn       String?
  districtZh      String?
  districtEn      String?
  licenceIssuedDate DateTime?
  licenceExpiryDate DateTime?
  phone           String?
  websiteUrl      String?
  isFeatured      Boolean  @default(false)

  // JSONB column — array of alternative name strings for trigram search.
  // aliases_text generated column and GIN index are defined in the raw migration SQL.
  searchAliases   Json     @default("[]")

  loanTypeTags    String[] @default([])

  // Valid values: employed | self-employed | freelancer | part-time | unemployed | no-hkid
  eligibilityTags String[] @default([])

  interestRateMin Decimal?
  interestRateMax Decimal?

  lastScrapedAt   DateTime?
  scrapeStatus    String?   // SUCCESS | PARTIAL | FAILED

  adminNote       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  activityEvents  ActivityEvent[]
  reviews         Review[]
  flags           Flag[]
  slugAliases     LenderSlugAlias[]

  @@map("Lender")
}

// ─── LenderSlugAlias ─────────────────────────────────────────────────────────
// Historical slugs kept alive as permanent redirects. Written by the slug
// migration script when a lender's slug is regenerated. Looked up by the
// lender detail page on 404 to permanent-redirect to the current slug.

model LenderSlugAlias {
  id        String   @id @default(cuid())
  oldSlug   String   @unique
  lenderId  String
  lender    Lender   @relation(fields: [lenderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([lenderId])
  @@map("LenderSlugAlias")
}

// ─── ActivityEvent ───────────────────────────────────────────────────────────
// Chronological log of registry-detected changes on a lender.
// Written by the HKMA scraper when a diff is detected.
// Displayed in the Lender Activity Feed and Lender Pulse widget.

model ActivityEvent {
  id            String   @id @default(cuid())
  lenderId      String
  lender        Lender   @relation(fields: [lenderId], references: [id], onDelete: Cascade)

  // eventType closed set: STATUS_CHANGE | ADDRESS_CHANGE | NAME_CHANGE
  eventType     String

  // Human-readable descriptions (TC required, EN optional)
  descriptionZh String
  descriptionEn String?

  // Timestamp when the scraper detected this change
  detectedAt    DateTime

  createdAt     DateTime @default(now())

  // Index on (lenderId, detectedAt DESC) for profile feed queries
  @@index([lenderId, detectedAt(sort: Desc)])
  @@map("ActivityEvent")
}

// ─── SeasonAlert ─────────────────────────────────────────────────────────────
// Admin-configured banners surfaced on public pages during high-demand periods.
// Story 7.4 / 7.5: CRUD via /admin/season-alerts; displayed when
// isActive = true AND current date falls within startDate–endDate.
// Cache tag: 'season-alerts' — busted by admin save/toggle.

model SeasonAlert {
  id           String   @id @default(cuid())
  titleZh      String
  titleEn      String?
  bodyZh       String
  bodyEn       String?
  ctaLabelZh   String
  ctaLabelEn   String?
  ctaUrl       String
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("SeasonAlert")
}

// ─── ScrapeRun ───────────────────────────────────────────────────────────────
// Audit log of each scraper run. Admin dashboard queries the last 20 runs.
// ARCH-15: admin dashboard shows a warning when last successful run is >8 days old.

model ScrapeRun {
  id               String   @id @default(cuid())
  source           String   // 'hkma' | 'cr' | 'rate-scraper'
  startedAt        DateTime
  completedAt      DateTime?
  lendersInserted  Int      @default(0)
  lendersUpdated   Int      @default(0)
  errorCount       Int      @default(0)
  status           String   // SUCCESS | PARTIAL | FAILED
  notes            String?

  createdAt        DateTime @default(now())

  @@map("ScrapeRun")
}

// ─── Review ──────────────────────────────────────────────────────────────────
// Community review of a licensed money lender.
//
// Status lifecycle: PENDING → APPROVED (public) | REJECTED
// The overall display rating is computed dynamically as:
//   (ratingApprovalSpeed + ratingRateAccuracy + ratingStaffAttitude + ratingTransparency) / 4.0
// It is NEVER stored as a column to prevent it going stale relative to the dimensions.
//
// Minimum 3 approved reviews are required before aggregate ratings are shown
// publicly (FR-16 / Story 3.4).

model Review {
  id                    String   @id @default(cuid())
  lenderId              String
  lender                Lender   @relation(fields: [lenderId], references: [id], onDelete: Cascade)

  // ── Submitter (Story 8.2 — FR-13) ────────────────────────────────────────
  // Nullable: pre-8.2 anonymous rows have no userId (see migration 2,
  // backfill_userid_placeholder). Every row created by 8.2-era code sets
  // this — "non-nullable going forward" is an application-level guarantee,
  // not a DB constraint, so legacy rows remain valid.
  userId                String?  @map("user_id")
  user                  User?    @relation(fields: [userId], references: [id])

  // ── 4-dimension ratings (1–5, all required) ─────────────────────────────
  ratingApprovalSpeed   Int
  ratingRateAccuracy    Int
  ratingStaffAttitude   Int
  ratingTransparency    Int

  // ── Content ─────────────────────────────────────────────────────────────
  body                  String   // 50–500 chars; stored as plain text, never rendered as HTML
  reviewerName          String?  // optional; max 20 chars; null displayed as "匿名"

  // ── Moderation ──────────────────────────────────────────────────────────
  status                String   @default("PENDING") // PENDING | APPROVED | REJECTED
  rejectionReason       String?

  // ── Community voting (Story 3.5) ─────────────────────────────────────────
  helpfulCount          Int      @default(0)
  notHelpfulCount       Int      @default(0)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Review abuse reports (Story 8.2, AC-8)
  reports               ReviewReport[]

  // ── Account deletion audit trail (Story 8.3, AC-8, FR-68) ────────────────
  // Populated ONLY when the submitting user deletes their account (AC-6):
  // userId is set to NULL, displayName snapshotted to '匿名用戶', and this
  // column set to sha256(user.id + ACCOUNT_HASH_SALT) so admin can still
  // group a deleted user's past submissions together without recovering
  // their identity. NULL for every row whose author has not deleted their
  // account (including pre-8.2 anonymous rows — see AC-9).
  deletedUserHash       String?  @map("deleted_user_hash")

  // One review per (user, lender) — FR-13 amendment: a repeat submission by
  // the same signed-in user edits the existing review instead of creating a
  // second row. NULL userId values are treated as distinct by Postgres, so
  // legacy anonymous rows never collide with this constraint.
  @@unique([userId, lenderId])
  // Index for paginated approved-reviews-by-lender queries (newest first)
  @@index([lenderId, status, createdAt(sort: Desc)])
  @@index([userId])
  @@index([deletedUserHash])
  @@map("Review")
}

// ─── Flag ─────────────────────────────────────────────────────────────────────
// Community red-flag submission for a licensed money lender.
//
// Status lifecycle: PENDING → APPROVED (public) | REJECTED
//
// Categories are stored as text constants (NOT Prisma enum) so adding a
// category requires only a code change, not a DB migration (FR-39, UX-DR8).
//
// Valid categories: HARASSMENT | ILLEGAL_TERMS | FAKE_IDENTITY | OVERCHARGING | OTHER
//
// Flag velocity (Story 4.4): rolling 30-day approved flag count displayed in
// Lender Pulse. Warning banner (Story 4.3): ≥5 approved flags in 90 days.
//
// Rate limit: 1 flag per (fingerprint+IP) per lender per 30 days (FR-43).

model Flag {
  id        String   @id @default(cuid())
  lenderId  String
  lender    Lender   @relation(fields: [lenderId], references: [id], onDelete: Cascade)

  // ── Submitter (Story 8.2 — FR-39/FR-43) ──────────────────────────────────
  // Nullable: pre-8.2 anonymous rows have no userId — see the Review model's
  // identical comment.
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])

  // Category from the fixed constant set — stored as text (not enum)
  category  String   // HARASSMENT | ILLEGAL_TERMS | FAKE_IDENTITY | OVERCHARGING | OTHER

  // Optional free-text description (max 500 chars)
  details   String?

  // ── IP retention (Story 8.2, AC-9) ───────────────────────────────────────
  // submissionIp did not exist before 8.2 — this story adds it alongside the
  // purge mechanism so there is something for the purge job to act on.
  // Nulled out by the daily purge job once ipPurgeAt has passed.
  submissionIp String?  @map("submission_ip")
  ipPurgeAt    DateTime @map("ip_purge_at")

  // Moderation lifecycle
  status    String   @default("PENDING") // PENDING | APPROVED | REJECTED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Account deletion audit trail (Story 8.3, AC-8, FR-68) — see Review's
  // identical field comment.
  deletedUserHash String? @map("deleted_user_hash")

  // Index for approved-flags-by-lender-by-date queries (velocity, warning banner)
  @@index([lenderId, status, createdAt(sort: Desc)])
  @@index([userId])
  @@index([ipPurgeAt])
  @@index([deletedUserHash])
  @@map("Flag")
}

// ─── ScamReport ───────────────────────────────────────────────────────────────
// User-submitted report of a suspected fraudulent lending entity.
//
// Status lifecycle: PENDING → VERIFIED (public) | REJECTED
//
// Verified reports appear on the public Scam Board (/zh/scam-board).
// Admin note is internal-only and never publicly displayed.
//
// Rate limit: 2 reports per (fingerprint+IP) per 24h.

model ScamReport {
  id                    String    @id @default(cuid())

  // ── Submitter (Story 8.2 — FR-33/FR-33a) ─────────────────────────────────
  // Nullable: pre-8.2 anonymous rows have no reporterUserId — see the Review
  // model's identical comment.
  reporterUserId        String?   @map("reporter_user_id")
  reporter              User?     @relation(fields: [reporterUserId], references: [id])

  // Reported entity details
  companyName           String
  licenceNumberClaimed  String?   // claimed licence number (may be fake)
  incidentDate          DateTime? // approximate incident date
  lossAmountHkd         Int?      // estimated financial loss in HKD

  // Required evidence text (100–2000 chars)
  evidenceText          String

  // ── IP retention (Story 8.2, AC-9) ───────────────────────────────────────
  // submissionIp did not exist before 8.2 — see the Flag model's identical
  // comment. Nulled out by the daily purge job once ipPurgeAt has passed.
  submissionIp          String?   @map("submission_ip")
  ipPurgeAt             DateTime  @map("ip_purge_at")

  // Moderation lifecycle
  status                String    @default("PENDING") // PENDING | VERIFIED | REJECTED
  adminNote             String?   // internal only, never public

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Account deletion audit trail (Story 8.3, AC-8, FR-68) — see Review's
  // identical field comment.
  deletedUserHash       String?   @map("deleted_user_hash")

  // Index for public scam board listing (newest verified first)
  @@index([status, createdAt(sort: Desc)])
  @@index([reporterUserId])
  @@index([ipPurgeAt])
  @@index([deletedUserHash])
  @@map("ScamReport")
}

// ─── ReviewReport ───────────────────────────────────────────────────────────
// Community abuse report against a Review — Story 8.2, AC-8 (FR-18).
// No moderation lifecycle of its own yet; the admin flag/scam-report queues
// pattern is the model for a future review-report queue (out of scope here).
//
// reporterUserId was originally non-nullable (Story 8.2: "always
// authenticated at creation, no legacy anonymous rows possible"). Story 8.3
// AC-6/AC-8 requires nulling it out on account deletion (same SET NULL
// treatment as Review/Flag/ScamReport, preserving the report content for
// admin's audit trail per FR-68) — that requires the FK to be nullable, so
// it changed to String? + onDelete: SetNull here. The original non-nullable
// reasoning about legacy rows still holds; nullability now stems from
// deletion, not from ever having had genuine anonymous rows.

model ReviewReport {
  id              String   @id @default(cuid())
  reviewId        String   @map("review_id")
  reporterUserId  String?  @map("reporter_user_id")
  reason          String
  submissionIp    String?  @map("submission_ip")
  ipPurgeAt       DateTime @map("ip_purge_at")
  createdAt       DateTime @default(now()) @map("created_at")
  review          Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter        User?    @relation(fields: [reporterUserId], references: [id], onDelete: SetNull)

  // Account deletion audit trail (Story 8.3, AC-8, FR-68) — see Review's
  // identical field comment.
  deletedUserHash String?  @map("deleted_user_hash")

  @@index([reviewId])
  @@index([reporterUserId])
  @@index([ipPurgeAt])
  @@index([deletedUserHash])
  @@map("review_reports")
}

// ─── Vote ─────────────────────────────────────────────────────────────────────
// Community upvote on a Review or a Red Flag — Story 8.3, AC-3 (FR-67).
//
// Polymorphic association (targetType/targetId) rather than two separate FK
// columns: a single model covers both Review and Flag targets without a
// second table. targetId is intentionally NOT a Prisma relation field — it
// is validated against the real Review/Flag row in application code
// (toggleVote), not enforced by the DB, matching the "vote count via
// count(votes WHERE...), not a denormalised counter" simplicity called for
// in the story spec.
//
// @@unique([userId, targetType, targetId]) is the load-bearing constraint:
// it is what makes "clicking twice removes the vote" and "one vote per user
// per item" actual DB-level guarantees, not just application logic.
//
// Cascades from User → Vote on account deletion (AC-6 step 4 deletes all of
// a user's Vote rows explicitly inside the transaction before the User row
// itself is deleted; the onDelete: Cascade here is a backstop for any vote
// rows that transaction step might miss, not the primary deletion path).

model Vote {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  targetType String   @map("target_type") // "review" | "flag"
  targetId   String   @map("target_id")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("votes")
}

// ─── NewsItem ─────────────────────────────────────────────────────────────────
// Regulatory/industry news items scraped from HKMA/SFC RSS feeds.
// Created with status DRAFT; admin reviews and publishes or rejects.
// Story 6.1: News Scraper, Draft Queue & Admin Publishing (FR-35, FR-36, FR-59)

model NewsItem {
  id                 String   @id @default(cuid())
  slug               String   @unique
  titleZh            String
  titleEn            String?
  bodyZh             String   @db.Text
  bodyEn             String?  @db.Text
  source             String   @unique // original URL (used as dedup key)
  publishedAt        DateTime
  status             String   @default("DRAFT") // DRAFT | PUBLISHED | REJECTED
  linkedLenderSlugs  String[] @default([])
  category           String   @default("general")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status, publishedAt(sort: Desc)])
  @@map("NewsItem")
}

// ─── Forum ────────────────────────────────────────────────────────────────────
// Community discussion board (Epic 9).
// Posts are public; both posts and replies support upvoting and soft-hide.
// Flat threading: replies may reference another reply via replyToId (quote context).

enum ForumCategory {
  LENDER_RECO     // 放債人推薦
  LOAN_QUESTION   // 貸款問題
  REPAYMENT       // 還款問題
  DEBT_CLEARANCE  // 清數討論
  INDUSTRY        // 行業討論
}

model ForumPost {
  id         String        @id @default(cuid())
  category   ForumCategory
  titleZh    String
  bodyZh     String        @db.Text
  authorName String        @default("匿名")
  upvotes    Int           @default(0)
  isHidden   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  replies    ForumReply[]

  @@index([category, createdAt(sort: Desc)])
  @@index([upvotes(sort: Desc)])
  @@map("ForumPost")
}

model ForumReply {
  id          String      @id @default(cuid())
  postId      String
  post        ForumPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  bodyZh      String      @db.Text
  authorName  String      @default("匿名")
  upvotes     Int         @default(0)
  isHidden    Boolean     @default(false)
  createdAt   DateTime    @default(now())

  // Flat threading — optional reference to another reply (quote context)
  replyToId   String?
  replyTo     ForumReply?  @relation("ReplyToReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ForumReply[] @relation("ReplyToReply")

  @@index([postId, createdAt(sort: Asc)])
  @@map("ForumReply")
}

// ─── Article ──────────────────────────────────────────────────────────────────
// AI-generated blog articles for the public /blog section.
// Created by the weekly generate-articles.ts script as drafts (isPublished=false).
// Admin reviews and publishes via /admin/articles.
// Story 8.1: AI Blog Article Generation.

enum ArticleCategory {
  LENDING
  PERSONAL_FINANCE
}

model Article {
  id             String          @id @default(cuid())
  slug           String          @unique
  titleZh        String
  bodyZh         String          @db.Text
  excerpt        String          @db.VarChar(200)
  category       ArticleCategory
  tags           String[]
  isPublished    Boolean         @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([isPublished, publishedAt(sort: Desc)])
  @@map("Article")
}

// ─── Auth.js (Borrower Authentication) ────────────────────────────────────────
// Story 8.1: Auth.js v5 Infrastructure & Email Magic Link.
// Soft-gate borrower identity — a separate island from admin's iron-session
// (ARCH-6). Table/column names follow the Auth.js Prisma adapter convention
// exactly (https://authjs.dev/getting-started/adapters/prisma) so the
// PrismaAdapter needs zero field-name configuration.
//
// Session strategy is 'database' (not JWT) per FR-65 — a Session row is
// created on sign-in and looked up on every request via the sessionToken
// cookie, giving a 30-day rolling expiry that a stateless JWT can't provide
// without extra plumbing.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  // Story 8.3, AC-1: account page shows "created-at date". Auth.js's default
  // PrismaAdapter User model (id/name/email/emailVerified/image) has no
  // createdAt column — neither Story 8.1 nor 8.2 added one, since neither
  // needed it. Added here; same class of missing-infrastructure gap as the
  // email-local-part display-name derivation above (see auth/config.ts).
  createdAt     DateTime  @default(now()) @map("created_at")
  accounts      Account[]
  sessions      Session[]

  // ── Community submission relations (Story 8.2) ───────────────────────────
  reviews       Review[]
  flags         Flag[]
  scamReports   ScamReport[]
  reviewReports ReviewReport[]

  // ── Voting (Story 8.3, AC-3) ──────────────────────────────────────────────
  votes         Vote[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
